# Copia este archivo a .env y reemplaza el placeholder.
# Docker Compose lee .env automaticamente.

BANXICO_TOKEN=PASTE_YOUR_BANXICO_TOKEN_HERE
PORT=8050
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=120
LIVE_REFRESH_SECONDS=900
DOF_LOOKBACK_DAYS=14
ARANCEL_MX_TIMEOUT_SECONDS=60
ARANCEL_MX_USER_AGENT=arancel-mx/1.0
ARANCEL_MX_STATE_PATH=data/arancel_mx/update_state/ligie_ledger.json
ARANCEL_MX_RELEASE_ROOT=data/releases

# Comex Bot Groq
GROQ_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_COMPLETION_TOKENS=1024
GROQ_TEMPERATURE=0.35
GROQ_TOP_P=1
