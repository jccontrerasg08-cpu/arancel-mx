{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "src/arancel_mx/api/static/site",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/trade",
      "destination": "/trade.html"
    },
    {
      "source": "/trade-analytics",
      "destination": "/trade-analytics.html"
    },
    {
      "source": "/data/v1/:path*",
      "destination": "https://jccontrerasg08-cpu.github.io/arancel-mx/v1/:path*"
    },
    {
      "source": "/(app(?:/.*)?|chapters|changes(?:/.*)?|data|learn|moa|wiki|glossary|trade-context|documentation|trust|records|features|releases|release-analytics|community)",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/v1/meta",
      "destination": "/data/v1/meta.json",
      "permanent": true
    },
    {
      "source": "/v1/sections",
      "destination": "/data/v1/sections.json",
      "permanent": true
    },
    {
      "source": "/v1/chapters",
      "destination": "/data/v1/chapters.json",
      "permanent": true
    },
    {
      "source": "/v1",
      "destination": "/documentation",
      "permanent": true
    },
    {
      "source": "/v1/:path*",
      "destination": "/documentation",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "/documentation",
      "permanent": true
    },
    {
      "source": "/docs/:path*",
      "destination": "/documentation",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/releases",
      "permanent": true
    },
    {
      "source": "/analytics",
      "destination": "/release-analytics",
      "permanent": true
    },
    {
      "source": "/product",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/moa-guide",
      "destination": "/moa",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/index-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/((?!index-).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
